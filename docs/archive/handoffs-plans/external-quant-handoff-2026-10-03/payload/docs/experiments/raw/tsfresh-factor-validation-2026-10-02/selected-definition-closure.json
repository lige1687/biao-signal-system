    "id": "research.external.mean_abs_log_change20",
    "version": "1.0.0",
    "name": "20日平均绝对对数变化",
    "type": "feature",
    "profile": "mixed",
    "uses": [
      "research_signal",
      "description",
      "comparison"
    ],
    "spec_anchor": [
      "用户2026-10-02授权外部因子挖掘与较大范围验证",
      "tsfresh0.21.2固定发布包两个函数，非LEI原文交易定义"
    ],
    "spec_layer": "external_price_information",
    "definition": {
      "formula": "r[j]=100*ln(C[j]/C[j-1]); X[t]=(1/20)*sum(abs(r[j]), j=t-19..t)",
      "parameters": {
        "window_returns": 20,
        "lag": null,
        "common_baseline_warmup": 252,
        "upstream_version": "0.21.2"
      },
      "unit": "log percentage points per session",
      "direction": "连续描述量，不事先指定未来收益方向",
      "transforms": "21个经济收盘价取100倍自然对数；上游两个函数正文不变；比较背景沿现有指标",
      "nan_policy": "缺报价/行动未知重置；共同252暖启动；任一候选未知则全部四比較同日资格未知，不填零",
      "endpoints": "t及以前21个连续经济收盘价；目标另从t+1收盘至t+21收盘"
    },
    "dependencies": [],
    "lifecycle": {
      "state": "exists",
      "basis": [
        "docs/experiments/raw/tsfresh-factor-validation-2026-10-02/protocol.json"
      ],
      "verification_scope": "研究适配器公式4340行独立重算、既有背景逐字段一致及5合成检查；效果尚未计算，研究限定"
    },
    "origin": "外部通用算法研究表达；无原作者预测有效性主张",
