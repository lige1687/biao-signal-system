+    category: CATEGORY_OVERRIDES.get(id) ?? CATEGORY_BY_GROUP[group],
+    keywords: SEARCH_ALIASES[id],
+  })),
+  ...EXTRA_INDICATORS,
+  ...MICRO_INDICATORS,
+];
