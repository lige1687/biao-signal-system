    "web/src/components/market-style",
    "web/src/components/focus-momentum",
    "web/src/api",
    "web/src/types.ts",
    "web/public/research"
  ],
  "write_paths": [
    "web/src/components/market-observation-alerts/IndicatorThumbnail.tsx",
