.breadth-comparison { padding: 14px 0 18px; border-top: 1px solid var(--border-subtle); color: var(--text-primary); font-size: var(--fs-body); }
.bc-heading { display: flex; justify-content: space-between; align-items: start; gap: 10px 20px; flex-wrap: wrap; }
.bc-heading h2 { margin: 0; font-size: var(--fs-title); }
.bc-heading p, .bc-scope, .bc-dates, .bc-caption, .bc-state { margin: 5px 0 0; color: var(--text-secondary); font-size: var(--fs-xs); line-height: 1.5; }
.bc-scope { font-size: var(--fs-body); font-weight: 600; color: var(--text-primary); }
.bc-controls, .bc-price-switch, .bc-window-switch, .bc-rules { display: flex; flex-wrap: wrap; align-items: center; gap: 5px 8px; }
.bc-controls button, .bc-rules button { border: 0; border-radius: var(--radius-sm); padding: 5px 8px; background: transparent; color: var(--text-secondary); cursor: pointer; }
.bc-controls button[aria-pressed="true"], .bc-rules button[aria-pressed="true"] { background: var(--bg-card-hover); color: var(--text-primary); font-weight: 600; }
.bc-controls button:hover, .bc-rules button:hover { color: var(--accent); }
.bc-market-controls { margin: 12px 0 8px; justify-content: space-between; padding-bottom: 8px; border-bottom: 1px solid var(--border-subtle); }
.bc-market-controls > div:first-child { background: var(--bg); border-radius: var(--radius-sm); padding: 2px; }
.bc-controls button:focus-visible, .bc-rules button:focus-visible, .bc-source summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
.bc-chart { width: 100%; min-width: 0; height: 450px; margin-top: 8px; }
.bc-dates { font-variant-numeric: tabular-nums; }
.bc-dates.bc-stale { color: var(--warn); font-weight: 600; }
.bc-error { color: var(--error); }
.bc-rules { margin-top: 12px; padding-top: 10px; border-top: 1px solid var(--border-subtle); font-size: var(--fs-xs); }
.bc-rules > span { color: var(--text-secondary); }
.bc-rules button { display: inline-flex; align-items: center; gap: 5px; }
.bc-rule-dot { width: 7px; height: 7px; border-radius: 50%; flex: none; }
.bc-caption { margin-top: 8px; }
.bc-source { margin-top: 10px; font-size: var(--fs-xs); color: var(--text-secondary); line-height: 1.6; }
.bc-source summary { width: fit-content; cursor: pointer; color: var(--accent); }
.bc-source p { max-width: 820px; margin: 8px 0 0; }
.bc-source a { color: var(--accent); margin-left: 4px; }
.bc-reader-controls { margin-top: 16px; justify-content: space-between; gap: 10px 16px; }
.bc-reader-controls > div { display: flex; align-items: center; gap: 3px; }
.bc-control-label { color: var(--text-secondary); margin-right: 6px; font-size: 12px; }
.bc-reader-controls label, .bc-review-controls label { display: flex; align-items: center; gap: 7px; font-size: 12px; color: var(--text-secondary); }
.bc-reader-controls select, .bc-review-controls select { color: var(--text-primary); background: var(--bg-card); border: 1px solid var(--border-subtle); border-radius: 5px; padding: 6px 8px; font: inherit; max-width: 100%; }
.bc-compare-toggle { cursor: pointer; white-space: nowrap; }
.bc-compare-toggle input { accent-color: #2563eb; }
.bc-track-hint { color: var(--text-secondary); font-size: 12px; line-height: 1.6; margin: 8px 0 0; }
.bc-review-controls { display: flex; align-items: center; flex-wrap: wrap; gap: 8px 14px; margin: 6px 0 14px; }
.bc-review-controls button { background: transparent; border: 0; padding: 5px 0; color: var(--accent); cursor: pointer; font: inherit; font-size: 12px; }
.bc-review-controls > span { color: var(--text-tertiary, var(--text-secondary)); font-size: 11px; margin-left: auto; }
.bc-reading { border: 1px solid var(--border-subtle); border-top: 3px solid #7890a3; border-radius: 6px; padding: 16px; background: var(--bg-card); }
.bc-reading[data-tone="supportive"] { border-top-color: #16847b; }
.bc-reading[data-tone="caution"] { border-top-color: #ad6d2d; }
.bc-reading-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
.bc-eyebrow { color: var(--text-secondary); font-size: 11px; font-variant-numeric: tabular-nums; }
.bc-reading-head h3 { font-size: 21px; margin: 4px 0 0; font-weight: 650; letter-spacing: .01em; color: var(--text-primary); }
.bc-reading-tag { color: var(--text-secondary); border: 1px solid var(--border-subtle); border-radius: 4px; padding: 3px 7px; font-size: 11px; flex-shrink: 0; }
.bc-reading-summary { color: var(--text-secondary); margin: 8px 0 14px; line-height: 1.65; font-size: 12px; }
.bc-reading-metrics { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
.bc-reading-metrics button { text-align: left; padding: 10px 12px; border: 1px solid var(--border-subtle); border-radius: 5px; background: transparent; font: inherit; color: var(--text-primary); cursor: pointer; min-width: 0; }
.bc-reading-metrics button[aria-pressed="true"] { border-color: #7b9bbb; background: var(--bg-card-hover); }
.bc-metric-label { display: flex; justify-content: space-between; align-items: center; gap: 5px; font-size: 12px; }
.bc-metric-label > span { color: var(--text-secondary); font-size: 11px; }
.bc-reading-metrics strong { display: block; font-size: 25px; font-weight: 600; font-variant-numeric: tabular-nums; margin: 6px 0; }
.bc-metric-change { color: var(--text-secondary); font-size: 11px; line-height: 1.5; display: block; }
.bc-metric-change b { font-variant-numeric: tabular-nums; font-weight: 600; color: var(--text-primary); }
.bc-track-reading { margin-top: 12px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px 16px; font-size: 12px; }
.bc-track-reading > div:first-child { display: flex; flex-direction: column; gap: 4px; }
.bc-track-reading > div:first-child > span { color: var(--text-secondary); font-size: 11px; }
.bc-track-values { display: flex; flex-wrap: wrap; gap: 10px 18px; color: var(--text-secondary); font-size: 11px; }
.bc-track-values b { color: var(--text-primary); margin-left: 3px; font-variant-numeric: tabular-nums; font-weight: 500; }
.bc-reading-footnote { font-size: 11px; color: var(--text-secondary); line-height: 1.6; margin: 12px 0 0; padding-top: 10px; border-top: 1px solid var(--border-subtle); }
.bc-legacy { margin-top: 15px; }
.bc-legacy .bc-rules { border: 0; padding-top: 0; }
.bc-reading button:focus-visible, .bc-review-controls button:focus-visible, .bc-reader-controls select:focus-visible, .bc-review-controls select:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
@media (max-width: 600px) {
  .bc-chart { height: 420px; }
  .bc-controls { width: 100%; justify-content: flex-start; }
  .bc-rules { gap: 5px 8px; }
  .bc-rules button { padding: 6px 4px; }
  .bc-reader-controls { gap: 8px 14px; }
  .bc-reader-controls > div { flex-basis: 100%; }
  .bc-reading { padding: 12px; }
  .bc-reading-head h3 { font-size: 20px; }
  .bc-reading-metrics { gap: 5px; }
  .bc-reading-metrics button { padding: 8px 6px; }
  .bc-metric-label { display: block; }
  .bc-metric-label > span { display: block; font-size: 10px; margin-top: 3px; }
  .bc-reading-metrics strong { font-size: 20px; }
  .bc-metric-change { font-size: 10px; }
  .bc-review-controls > span { display: none; }
}
