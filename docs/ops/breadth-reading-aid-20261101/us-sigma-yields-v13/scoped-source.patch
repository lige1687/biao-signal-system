+  if (collapsed) return null;
+  const toggle = (sigma: ErpSigma) => {
+    if (sigmas.length === 1 && sigmas.includes(sigma)) return;
+    setSigmas(sigmas.includes(sigma) ? sigmas.filter(value => value !== sigma) : [...sigmas, sigma].sort());
+  };
+  return <article className="moa-item us-erp-card" data-tone={!historical && crossed !== undefined ? z! < 0 ? "caution" : "supportive" : "neutral"} aria-label="标普500 · 股债利差" data-overview-card="erp-us">
