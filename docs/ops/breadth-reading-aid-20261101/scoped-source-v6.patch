+++ after-v6/web/src/components/market-observation-alerts/MiniTrend.tsx
@@ -0,0 +1,40 @@
+type Line = { name: string; color: string; values: (number | null)[] };
+const finite = (v: number | null | undefined): v is number => typeof v === "number" && Number.isFinite(v);
+
+/** A small, date-aligned view of supplied observations; missing points break the line. */
+export default function MiniTrend({ dates, lines, lower, upper, percent = false, label }: {
+  dates: string[]; lines: Line[]; lower?: (number | null)[]; upper?: (number | null)[];
+  percent?: boolean; label: string;
+}) {
+  if (dates.length < 2 || !lines.some(line => line.values.filter(finite).length >= 2)) return <div className="moa-mini-empty">趋势资料不足</div>;
+  const values = [...lines.flatMap(line => line.values), ...(lower ?? []), ...(upper ?? [])].filter(finite);
+  if (!values.length) return <div className="moa-mini-empty">趋势资料不足</div>;
+  const low = percent ? 0 : Math.min(...values);
+  const high = percent ? 100 : Math.max(...values);
+  const span = high - low || 1;
+  const start = Date.parse(dates[0]);
+  const elapsed = Date.parse(dates[dates.length - 1]) - start || 1;
+  const x = (i: number) => 8 + (Date.parse(dates[i]) - start) / elapsed * 304;
+  const y = (v: number) => 12 + (high - v) / span * 94;
+  const path = (data: (number | null)[]) => {
+    let drawing = false;
+    return dates.map((_, i) => {
+      const value = data[i];
+      if (!finite(value)) { drawing = false; return ""; }
+      const command = `${drawing ? "L" : "M"}${x(i).toFixed(2)},${y(value).toFixed(2)}`;
+      drawing = true;
+      return command;
+    }).join(" ");
+  };
+  return <div className="moa-mini">
+    <svg viewBox="0 0 320 120" role="img" aria-label={label}>
+      <title>{label}</title>
+      {percent && <><path d={`M8,${y(50)}H312`} stroke="#9caaba" strokeDasharray="3 4" fill="none" />
+        <text x="9" y={y(50) - 5} fill="#78889a" fontSize="9">50% · 半数股票</text></>}
+      {lower && <path d={path(lower)} stroke="#bb8b4b" strokeDasharray="4 3" strokeWidth="1.2" fill="none" />}
+      {upper && <path d={path(upper)} stroke="#368d80" strokeDasharray="4 3" strokeWidth="1.2" fill="none" />}
+      {lines.map((line, i) => <path key={line.name} d={path(line.values)} stroke={line.color} strokeWidth={i === 0 ? 2.3 : 1.4} strokeLinejoin="round" strokeLinecap="round" fill="none" />)}
+    </svg>
+    <div className="moa-mini-dates"><span>{dates[0]}</span><span>{dates[dates.length - 1]}</span></div>
+  </div>;
+}
