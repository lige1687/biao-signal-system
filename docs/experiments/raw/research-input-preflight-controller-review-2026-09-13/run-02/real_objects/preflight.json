     "id": "mixed.momentum.raw",
     "version": "1.0.0",
     "name": "252至21有效报价涨幅",
     "type": "feature",
     "profile": "mixed",
     "uses": [
      "ranking",
      "description",
      "research_signal"
     ],
     "dependencies": [
      "mixed.price.economic@1.0.0"
     ],
     "definition": {
      "formula": "I(t-21)/I(t-252)-1",
      "parameters": {
       "long_lag": 252,
