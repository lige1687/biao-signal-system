    "definition_closure": {
      "research.a01.signed_band@1.0.1": {
        "id": "research.a01.signed_band",
        "version": "1.0.1",
        "name": "A01决策收盘至双均线组的有符号ATR距离",
        "type": "feature",
        "uses": [
          "description",
          "research_signal"
        ],
        "not_for": [
          "production_trade",
          "best_threshold_selection",
          "actual_account_return_claim"
        ],
        "scope": "固定六只国内宽基ETF2022-01-01—2026-06-30的周/月上升趋势状态研究；非原A事件准入规则",
        "definition": {
          "formula": "lo=min(SMA_N,EMA_N); hi=max(SMA_N,EMA_N); d=(close-hi)/ATR20 if close>hi; d=(close-lo)/ATR20 if close<lo; else0。",
          "parameters": {
            "N": [
              20,
              60,
              120
            ],
            "EMA_alpha": "2/(N+1)",
            "ATR_smoothing": "seeded EMA20 of true range",
            "warmup_calendar_rows": 252,
            "class_boundaries": [
              -1,
              0,
              1
            ],
            "threshold_semantics": "用于完整比较的固定描述分组，不是交易阈值"
          },
          "endpoints": "全部指标含决策日收盘；低价与当日均线的几何描述只在收盘后可知；EMA从首有效行的连续N行种子，内部缺价永久未知且不重启；SMA完整N交易日滚动可恢复。TR=max(H-L,abs(H-prevC),abs(L-prevC))，首日TR未知；以首个有效连续20行TR均值为EMA20种子（无缺价时第21原始行），中途缺TR后永久未知且不重启。",
          "unit": "ATR20倍数（有正负）；不是收益百分比",
          "direction": "无越近越好预设；负值表示低于组，0表示组内，正值表示高于组",
          "transforms": "d、d²、inside；五固定描述组；低价距离和单线百分比仅保留/诊断"
        },
        "input": {
          "fields": [
            "date",
            "nominal_OHLC",
            "economic_index",
            "nominal_close",
            "calendar"
          ],
          "price_basis": "economic OHLC proxy=nominal OHLC*same-date economic_index/nominal_close；经济指数已含行动，不重复加分红；不能当实际成交价",
          "currency": "CNY underlying，经济指数任意尺度；ATR距离无单位",
          "frequency": "daily观察；W/M收盘决策",
          "calendar": "既有SZSE官方月度接口合并日历，沪市使用共同日期，非新独立SSE日历资格"
        },
        "universe": {
          "version": "A01-guide-technical-20260929-six-fixed-domestic-ETF",
          "eligibility": "全体固定W/M时点SMA60(t)>SMA60(t-5)且指标有效；不以距离、首次、RR、未来标签或成功成交预筛",
          "warmup": "252原始日历行统一起点，SMA20/60/120完整窗口；EMA首N行均值种子；仅复用已封存输入",
          "missing": "缺行保留，不插值/前填/重种子；ATR<=0或缺失、价格或均线未知逐行排除并保留原因；未来标签缺失另列不能改变因子母样本",
          "quality_gate": "历史数据到达时间未知；OHLC经济映射是研究代理；保留六ETF排除账，不隐藏无法计算ETF",
          "degrade": "unknown与空组显示null及原因，不填0，不推为原A部署效果"
        },
        "time": {
          "observation_time": "已完成日线收盘",
          "available_at": "理论当日收盘后；历史逐条到达未知",
          "decision_at": "每周/每月最后实际交易日收盘后",
          "execution_at": "仅未来结果评价用下一交易日开盘代理；非交易授权",
          "timezone": "Asia/Shanghai",
          "effective_from": "2026-09-29研究定义登记，不追溯实盘参数"
        },
        "dependencies": [],
        "validation": {
          "method": "执行者人工边界与前缀测试、独立源审查186项、主控独立源重建与关键拟合300项；语义映射非自动计算入口",
          "tolerance": {
            "absolute": 1e-10,
            "relative": 1e-10,
            "integer": 0
          },
          "tests": [
            "docs/experiments/raw/a01-guide-study-2026-09-29/controller-check.json",
