{
  "id": "research.risk.slope_change60_20",
  "version": "1.0.0",
  "name": "SMA60斜率变化的未来20日下探研究用途",
  "type": "feature",
  "profile": "mixed",
  "uses": [
    "research_signal",
    "description",
    "comparison"
  ],
  "not_for": [
    "production_trade",
    "holding_entry_or_exit",
    "actual_account_return_claim",
    "complete_LEI_state",
    "unique_author_calibration"
  ],
  "scope": "四ETF已见历史的趋势动态表达",
  "spec_anchor": [
    "桌面LEI技术交易体系§2.4",
    "桌面LEI技术实现§4.4"
  ],
  "spec_layer": "trend_road_information",
  "definition": {
    "formula": "s[t]=100*252/60*ln(SMA60[t]/SMA60[t-60]); X[t]=s[t]-s[t-20]",
    "parameters": {
      "sma_length": 60,
      "slope_window": 60,
      "annualization": 252,
      "change_lag": 20,
      "warmup": 252,
      "target": "100*max(0,1-min(close[t+1:t+22])/close[t+1])"
    },
    "unit": "annualized log percentage-point change",
    "direction": "风险方向由检验决定",
    "transforms": "V01绑定名义OHLC和行动重建的回顾性经济OHLC；EMA20前20收盘SMA播种，ATR14简单平均",
    "nan_policy": "缺报价或行动未知重置全部连续指标和结构；252不足未知",
    "endpoints": "t及以前的完整日线；未来收盘路径t+1..t+21，含首尾"
  },
  "input": {
    "fields": [
      "date",
      "open",
      "high",
      "low",
      "close",
      "calendar",
      "action_known"
    ],
    "price_basis": "从指纹绑定名义OHLC/行动清单经economic_index及同行动日仿射公式逐行复核的经济价格",
    "currency": "CNY ETF经济价格指数",
    "frequency": "daily",
    "calendar": "四ETF共同完整交易日历",
    "sources": "docs/experiments/raw/volume-information-2026-09-30/execution/source-manifest.json"
  },
