    "definitions": {
      "eligibility": "eligible only if historically listed at decision close, actual positive month-end traded quote, at least 253 valid quotes, finite momentum/short/vol60/amount20 and historical isST=0; source errors can block whole month",
      "vol60": "Sample standard deviation of 60 simple daily returns over 61 consecutive market dates ending at decision close, annualized by square root of 252; missing dates block the feature, not silently skipped",
      "momentum": "Close at 21 valid trading quotes ago divided by close 252 valid trading quotes ago minus one; may span more than 252 calendar days after suspension",
      "future_return": "Front-adjusted close at first market date of following month divided by front-adjusted close at first market date of current month minus one; suspended entry/exit with valid marked close returns a proxy and is flagged, missing/invalid endpoints return null",
      "baseline_count": "Existing momentum_top20 selects ceil(20% of same eligible monthly pool), descending momentum then code tie-break; new lower-volatility arm can select identical count ascending vol60 then code tie-break, with fixed equal target weights"
    },
    "feasibility": "Saved columns suffice for one bounded same-month, same-count low-volatility versus momentum price-outcome diagnostic without re-reading daily quote sources. New low-volatility selection weights, method monthly aggregation, unknown-weight accounting and replacement rate must be calculated from saved rows; no extra historical feature needs recomputation. A fixed lower-capital comparator must be specified separately; the existing panel is not a filled-account ledger.",
    "limitations": [
      "future_return is quote change, not executable trade or account drawdown",
      "marked suspended endpoints may have a price proxy but no fill; keep separate from fully traded outcomes",
      "later exits and missing endpoints retain null and target weight; no inferred recovery proceeds",
      "front-adjusted BaoStock price is a proxy and has no independent complete corporate-action verification",
      "all 132 months and prices were previously examined; any new result is exploratory"
    ]
  },
