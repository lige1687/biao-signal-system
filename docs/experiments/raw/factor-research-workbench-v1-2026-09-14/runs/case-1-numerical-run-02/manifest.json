      "id": "mixed.rv20",
      "version": "1.0.0",
      "name": "20期简单收益的样本波动",
      "type": "feature",
      "profile": "mixed",
      "uses": [
        "description",
        "diagnostic"
      ],
      "dependencies": [
        "mixed.asset.total_return@1.0.0"
      ],
      "definition": {
        "formula": "std(I_t/I_prev-1 over last20,ddof=1)*sqrt(252)",
        "parameters": {
          "window": 20,
          "ddof": 1,
          "annualization": 252
        },
        "endpoints": "含t；有位移时以formula和parameters为准",
        "unit": "fraction",
        "direction": "见公式；无默认好坏评价",
        "transforms": "无"
      }
    },
