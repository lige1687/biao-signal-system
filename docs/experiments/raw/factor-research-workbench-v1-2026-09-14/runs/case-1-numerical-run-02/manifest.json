      "id": "mixed.momentum.raw",
      "version": "1.0.0",
      "name": "252至21有效报价涨幅",
      "type": "feature",
      "profile": "mixed",
      "uses": [
        "ranking",
        "description",
        "research_signal"
      ],
      "dependencies": [
        "mixed.price.economic@1.0.0"
      ],
      "definition": {
        "formula": "I(t-21)/I(t-252)-1",
        "parameters": {
          "long_lag": 252,
          "skip_lag": 21
        },
        "endpoints": "自身有效报价行位移；第253条首次可算；不含最近21条",
        "unit": "fraction",
        "direction": "降序排序，负分允许",
        "transforms": "无标准化、无截尾、无年化"
      }
    },
