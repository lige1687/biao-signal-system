    {
      "id": "mixed.momentum.raw",
      "version": "1.0.0",
      "name": "252至21有效报价涨幅",
      "type": "feature",
      "profile": "mixed",
      "uses": [
        "ranking",
        "description",
        "research_signal"
      ],
      "dependencies": [
        "mixed.price.economic@1.0.0"
      ],
      "definition": {
        "formula": "I(t-21)/I(t-252)-1",
        "parameters": {
          "long_lag": 252,
          "skip_lag": 21
        },
        "endpoints": "自身有效报价行位移；第253条首次可算；不含最近21条",
        "unit": "fraction",
        "direction": "降序排序，负分允许",
        "transforms": "无标准化、无截尾、无年化"
      },
      "universe": {
        "eligibility": "按本对象有效报价窗口计算；计算本身不要求273条，273仅属于月选资格"
      },
      "status": {
        "implementation": "isolated_formula_or_selection_compared_with_legacy; consumers_not_migrated"
      },
      "lifecycle": {
        "state": "verified",
        "basis": [
          "docs/research/definitions.v1.json",
          "tests/unit/test_research_definitions.py"
        ],
        "verification_scope": "函数级合成精确值验证与resolve/calculate身份参数绑定（仅该测试文件覆盖范围）；未做账户级回放，不构成有效性或生产授权"
      }
