+def price50_targets(continuous: pd.Series) -> tuple[pd.Series, pd.Series]:
+    """Binary target from the last 50 valid closes; equality maps to cash."""
+    valid = continuous.dropna().astype(float)
+    sma = valid.rolling(50, min_periods=50).mean()
+    target = (valid > sma).astype(float)
+    target[sma.isna()] = np.nan
+    return target.reindex(continuous.index), sma.reindex(continuous.index)
+
+
+def state_change_order(previous: float | None, target: float, day: pd.Timestamp):
+    """A newer close state replaces any older unfilled order."""
+    if previous is not None and target == previous:
+        return previous, None
+    return target, {"kind": "target", "signal_date": day, "target": target,
+                    "band": False, "reason": "price_sma50_state"}
 
 
