+    # ---------------- 健康状态只读聚合（2026-09-17 S1） ----------------
+
+    def health_aggregates(self) -> dict:
+        """健康状态所需的三项轻量聚合（不全表载入正文）。
+
+        - latest_success_at：最近一次**明确采集成功**（stages.collect.status
+          == 'ok'）的完成时间；部分失败不算，旧记录没有阶段字段不回填
+          （不追溯伪造成功，保持 None）；
+        - latest_item_at：库里最新消息的发布时间（MAX(published_at)）；
+        - unscored_count：未评分数（仅计数，不据此推断成败）。
+        """
+        latest_success: str | None = None
+        for r in self._conn.execute(
+            "SELECT finished_at, stats_json FROM news_runs ORDER BY id DESC LIMIT 100"
+        ):
+            try:
+                stats = json.loads(r["stats_json"] or "{}")
+            except ValueError:
+                continue
+            stages = stats.get("stages") if isinstance(stats, dict) else None
+            if not isinstance(stages, dict):
+                continue  # 旧格式：无明确阶段记录，不冒充成功
+            collect = stages.get("collect") or {}
+            if collect.get("status") == "ok":
+                latest_success = collect.get("finished_at") or r["finished_at"]
+                break
+        row = self._conn.execute("SELECT MAX(published_at) AS m FROM news_items").fetchone()
+        unscored = self._conn.execute(
+            "SELECT COUNT(*) AS n FROM news_items WHERE importance IS NULL"
+        ).fetchone()["n"]
+        return {
+            "latest_success_at": latest_success,
+            "latest_item_at": row["m"],
+            "unscored_count": int(unscored or 0),
+        }
+
+    def official_recent(
