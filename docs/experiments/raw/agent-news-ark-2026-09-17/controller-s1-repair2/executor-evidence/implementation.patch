+            self._conn.execute(
+                "SELECT id, source, source_name, url, category, title, summary, "
+                "importance, direction, published_at, ingested_at "
+                "FROM news_items WHERE source = ? AND published_at >= ? "
+                "ORDER BY published_at DESC LIMIT ?",
