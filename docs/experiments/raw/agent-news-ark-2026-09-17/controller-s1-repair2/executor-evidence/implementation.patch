+        "<pubDate>Wed, 16 Sep 2099 14:00:00 GMT</pubDate></item>"
+        "<item><title>Federal Reserve issues FOMC statement</title>"
+        "<link>https://www.federalreserve.gov/x.htm</link>"
+        "<pubDate>Wed, 16 Sep 2026 18:00:00 GMT</pubDate></item>"
+        "</channel></rss>"
+    )
