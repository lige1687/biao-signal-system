  "field_meaning": {
    "cash_distribution": {
      "source_statement": "本基金本报告期未进行利润分配，符合相关法规及基金合同的规定。",
      "assessment": "八份均为管理人针对本基金本年度的直接否定陈述，不靠旧事件表为空、没有搜到公告或托管人笼统合规意见推断。可支持原cash_distribution类事后零事件及这一类分配金额为零。",
      "not_supported": [
        "不代表基金没有从所持股票收到股息或没有利息、证券出借等收入。",
        "不代表投资者账户没有银行流水，也不核定跨年度应收、迟到现金或客户实际到账；不能把annual_cash_amount=0称作账户现金核验。",
        "不代表报告期以后不会分红。"
      ]
    },
    "share_adjustment": {
      "source_statement": "本报告期基金拆分变动份额 -",
      "assessment": "在完整命名的年度基金份额变动表中，这一行横线可按该报告字段口径解释为本年度无基金拆分变动，足以支持原share_adjustment中拆分/折算这一限定用途；不是任意空白单元格。8份原文均将申购、赎回单列，所以份额总量变化不构成拆分反例。",
      "derived_count_caveat": "annual_event_count=0是此限定字段的事后解释，不是年报直接提供逐笔事件数；保留原横线及表名，不能把它扩成所有形式的基金重组、合并、转型或全部权益事项的逐笔完整性证明。",
      "not_supported": [
        "份额申购赎回金额不是拆分比例。",
        "不能把表中前后出现的联接基金持有份额或所持证券交易事项当作本ETF拆分。",
        "不给split_date或split_ratio补造日期、1或其他值；保持null。"
      ]
    }
  },
