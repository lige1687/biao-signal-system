  "required_interpretation_corrections": [
    {
      "id": "monday_anchor_not_decision",
      "where": [
        "plain_language_conclusion",
        "event_dependencies[].earliest_later_regular_weekly_decision_calendar_candidate",
        "pay_date_shape_summary.same_week_decision_relation",
        "specific_execution_questions.dividend_credit_clock.when_material"
      ],
      "finding": "日期算术正确，但把周一00:00普遍称为决策时刻、把下周一称最早后续周决策，超出原spec。周末决策可能更早；周一入金可另触发安排，不等于所有决策固定在此。",
      "suggested_fix": "保留两列为same_week_monday_deposit_anchor/next_week_monday_anchor；真实decision_at和frozen_at未定时保持unknown。四笔周一支付不能仅凭日期进入00:00现金，亦不能自动进入此前周末决策。是否可用于后续安排按实际冻结时点判断。",
      "severity": "必须限定，避免下游按错误时钟执行。"
    },
    {
      "id": "actual_receipt_not_universal_research_prerequisite",
      "where": [
        "plain_language_conclusion",
        "event_dependencies[].later_decision_cash_condition",
        "event_dependencies[].account_effect_if_entitled",
        "event_dependencies[].planning_effect"
      ],
      "finding": "这些行的only evidenced/exact措辞若推广为所有未来研究前置过严，并与minimum_resolution允许显式保守研究时序的段落不一致。",
      "suggested_fix": "统一区分实际到账事实与研究情景。旧模型事实输入不能凭计划日期冒填；未来独立冻结研究合同可以给双方同一保守可用时序，明确假设、边界和现金等待影响，使用scenario_available_at或明确类型，actual_credit_timestamp仍unknown。不得据此把旧输入自动qualified或擅改原pay_at来源意义。",
      "severity": "必须前置说明，不把所有历史银行回执变成永久任务。"
    },
    {
      "id": "time_precision_matches_decision",
      "where": [
        "event_dependencies[].later_decision_cash_condition"
      ],
      "finding": "即使要求事实证据，所需通常是证明可用时间不晚于冻结点，而非所有支付的精确秒级银行时刻。",
      "suggested_fix": "证据精度只需足以判定先后；若日期或可信时间区间已完全在冻结之前，不应额外要求更细时钟。若仍跨冻结点，则unknown或按新明确保守情景处理。"
    }
  ],
