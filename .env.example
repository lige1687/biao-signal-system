# LEI 看盘系统 · 环境变量示例
# 复制为 .env 并填入真值。.env 已被 .gitignore 忽略，绝不提交真实凭据。

# ---------------- 存储 ----------------
# SQLite 路径（默认项目根 lab.db）
# LEI_SQLITE_PATH=/Users/you/lei-signal-lab/lab.db

# ---------------- ark（表达层 LLM，仅用于把 alert 讲成人话）----------------
# 缺 ARK_API_KEY 时监督员自动降级为模板渲染，功能不中断。
# ARK_API_KEY=
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# ARK_MODEL=ark-code-latest

# ---------------- 飞书投递（v2，未实现时留空）----------------
# 自建应用凭据（可发交互卡 + 收回调）
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# 回调验签用
# FEISHU_ENCRYPT_KEY=
# FEISHU_VERIFICATION_TOKEN=
# 接收方：chat_id 或 open_id
# FEISHU_RECEIVE_ID=
# 交互回执开关：未开公网回调时保持 false（卡片按钮退化为深链）
# FEISHU_ENABLE_CALLBACK=false
